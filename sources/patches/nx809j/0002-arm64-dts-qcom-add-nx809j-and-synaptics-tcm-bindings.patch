@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/synaptics,tcm-spi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Synaptics TouchComm SPI touchscreen
+
+maintainers:
+  - Luka Panio <lukapanio@gmail.com>
+
+description: |
+  Binding for the Synaptics TouchComm SPI interface registered by the pinned
+  XEC synaptics_tcm_spi driver. This schema covers the properties present in
+  the NX809J review candidate; that device node remains disabled pending
+  protocol and power-sequence validation.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: synaptics,tcm-spi
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  spi-max-frequency: true
+
+  reset-gpios:
+    maxItems: 1
+
+  vdd-supply:
+    description: Optional controller core supply.
+
+  avdd-supply:
+    description: Optional controller analog supply.
+
+  synaptics,power-delay-ms:
+    description: |
+      Delay after enabling the optional supplies and before reset is asserted.
+      The pinned XEC driver defaults to 200 ms when this property is absent
+      or zero.
+    minimum: 0
+
+  synaptics,reset-active-ms:
+    description: |
+      Duration of reset assertion. The pinned XEC driver defaults to 10 ms
+      when this property is absent or zero.
+    minimum: 0
+
+  synaptics,reset-delay-ms:
+    description: |
+      Delay after reset is deasserted and before controller initialization
+      continues. The pinned XEC driver defaults to 80 ms when this property
+      is absent or zero.
+    minimum: 0
+
+unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - spi-max-frequency
+
+examples:
+  - |
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "synaptics,tcm-spi";
+            reg = <0>;
+            spi-max-frequency = <10000000>;
+            interrupts = <1>;
+            synaptics,power-delay-ms = <200>;
+        };
+    };
+...
